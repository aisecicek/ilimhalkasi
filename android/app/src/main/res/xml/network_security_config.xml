<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- Yerel geliştirme için LAN IP istisnası; gerçek dağıtımda HTTPS kullanılır. -->
