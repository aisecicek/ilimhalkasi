<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Yerel/LAN geliştirme aşamasında kullanıcı sunucu adresini uygulama içinden
      değiştirebiliyor. Bu yüzden HTTP'ye tüm host'lar için izin veriyoruz.
      Herkese açık HTTPS yayına geçildiğinde base-config tekrar false yapılır.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
