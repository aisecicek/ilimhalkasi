[Unit]
Description=İlim Halkası API sunucusu
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ilimhalkasi
Group=ilimhalkasi
WorkingDirectory=/opt/ilimhalkasi
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=HOST=127.0.0.1
Environment=ILIMHALKASI_PRODUCTION=1
Environment=ILIMHALKASI_DB_DIR=/var/lib/ilimhalkasi
Environment=ILIMHALKASI_TRUST_PROXY=1
Environment=COOKIE_SECURE=1
# Parolalar, gerçek KVKK/SMTP bilgileri ve APP_BASE_URL buraya YAZILMAZ.
# /etc/ilimhalkasi.env dosyasını 0600 yetkiyle oluşturun; şablon:
#   deploy/ilimhalkasi.env.example
# Eksik veya örnek değer varsa sunucu açılışta durur.
EnvironmentFile=/etc/ilimhalkasi.env
ExecStart=/usr/bin/python3 /opt/ilimhalkasi/server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ilimhalkasi

[Install]
WantedBy=multi-user.target
