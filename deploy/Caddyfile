# İlim Halkası — HTTPS ters proxy örneği
# Kullanım: caddy run --config deploy/Caddyfile
# APP_BASE_URL=https://ilimhalkasi.example.com COOKIE_SECURE=1 python server.py

ilimhalkasi.example.com {
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Strict-Transport-Security "max-age=31536000"
        -Server
    }

    # APK ve web aynı origin'i kullandığından oturum çerezi aynı kalır.
    # Caddy X-Forwarded-For'u otomatik ekler; sunucu TRUST_PROXY=1 ile okur.
    reverse_proxy 127.0.0.1:8765 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
    }
}
