# /etc/ilimhalkasi.env için örnek. Gerçek değerleri yazın, dosyayı 0600 yapın.
# Bu dosyayı doğrudan kopyalamayın: DEGISTIRIN/example değerleri üretimde reddedilir.

IH_ADMIN_PASSWORD=DEGISTIRIN_GUC_BIR_SIFRE

# Gerçek KVKK bilgileri (varsayılan geliştirme adresleri üretimde reddedilir):
ILIMHALKASI_KVKK_CONTACT=kvkk@DEGISTIRIN.example
ILIMHALKASI_DATA_CONTROLLER=DEGISTIRIN_GERCEK_KURUM_ADI

# Doğrulama/sıfırlama bağlantılarında kullanılacak gerçek HTTPS adresi.
APP_BASE_URL=https://DEGISTIRIN.example

# Gerçek SMTP sağlayıcısı.
SMTP_HOST=smtp.DEGISTIRIN.example
SMTP_PORT=587
SMTP_USER=noreply@DEGISTIRIN.example
SMTP_PASSWORD=DEGISTIRIN_SMTP_SIFRESI
SMTP_FROM=İlim Halkası <noreply@DEGISTIRIN.example>
SMTP_USE_TLS=1

# İsteğe bağlı; varsayılanlar güvenlidir, değiştirmenize gerek yok.
# ILIMHALKASI_CSRF=1
# ILIMHALKASI_RATE_LIMIT=1
# ILIMHALKASI_REQUIRE_EMAIL_VERIFICATION=1
