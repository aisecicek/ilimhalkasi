# /etc/ilimhalkasi.env için örnek. Gerçek değerleri yazın, dosyayı 0600 yapın.
# Bu dosyayı repo'ya kopyalamayın; parolalar burada tutulur.

IH_ADMIN_PASSWORD=DEGISTIRIN_GUC_BIR_SIFRE
SMTP_PASSWORD=DEGISTIRIN_SMTP_SIFRESI

# Gerçek KVKK bilgileri (varsayılanlar yalnızca geliştirme içindir):
# ILIMHALKASI_KVKK_CONTACT=kvkk@example.com
# ILIMHALKASI_DATA_CONTROLLER=İlim Halkası Derneği
